# Copy this file to .env for local development (used by both mcp_server/
# and dashboard/ - copy it into whichever folder you're running from, or
# export these as real env vars).
#
# Open-Meteo needs NO api key at all, so the only secret this project has
# is the Lakebase URL used for (best-effort) query logging - the weather
# tools themselves work with zero secrets configured. In production on
# Databricks Apps, LAKEBASE_URL is injected from the "database/lakebase-url"
# secret via app.yaml - do NOT put a real secret value in this file or
# commit a filled-in .env.

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require
